# docker-compose.yml icin ortam degiskenleri.
# Portainer kullaniyorsaniz bu degerleri stack'in "Environment variables" bolumune girin.
# Yerelde:  cp .env.example .env

# --- Veritabani ---
POSTGRES_USER=futbolvitrini
POSTGRES_PASSWORD=degistir-guclu-bir-parola
POSTGRES_DB=futbolvitrini

# --- JWT sirlari (uretimde mutlaka uretin: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=degistir-en-az-32-karakterlik-access-secret
JWT_REFRESH_SECRET=degistir-en-az-32-karakterlik-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Uygulama ---
# Tarayicinin uygulamaya eristigi adres(ler). Virgulle ayirin.
CORS_ORIGINS=http://localhost:8080
# Alt alan adlari arasinda cookie paylasmak icin (orn: .futbolvitrini.com). Bos birakilabilir.
COOKIE_DOMAIN=
# Yerel http://localhost:8080 icin false; HTTPS kullanan gercek deploy'da true yapin.
COOKIE_SECURE=false
# Frontend ayni origin uzerinden /api/v1 kullanacaksa bos birakin.
VITE_API_URL=

# --- Portlar ---
FRONTEND_PORT=8080

# --- Imaj etiketleme ---
REGISTRY_PREFIX=futbolvitrini
TAG=latest

# --- Diger ---
TZ=Europe/Istanbul
RUN_MIGRATIONS=true
# Idempotent demo verisini ve bilinen hesaplari olusturur.
# Internet'e acik gercek uretimde ilk basarili kurulumdan sonra false yapin.
RUN_SEED=true
