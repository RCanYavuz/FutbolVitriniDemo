# Bu dosyayi .env olarak kopyalayin: cp .env.example .env
NODE_ENV=development
PORT=3000

# Docker compose disinda calisirken host'u localhost yapin
DATABASE_URL="postgresql://futbolvitrini:futbolvitrini@localhost:5432/futbolvitrini?schema=public"

# Uretimde mutlaka degistirin: openssl rand -hex 32
JWT_ACCESS_SECRET="dev-access-secret-en-az-32-karakter-olmali-1234"
JWT_REFRESH_SECRET="dev-refresh-secret-en-az-32-karakter-olmali-123"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Virgulle ayrilmis izinli origin listesi
CORS_ORIGINS=http://localhost:5173

# Cookie domain (bos birakilirsa istek host'u kullanilir)
COOKIE_DOMAIN=
# Yerel HTTP'de false; HTTPS uretim deploy'unda true olmalidir.
COOKIE_SECURE=false

# Swagger arayuzunun yolu
SWAGGER_PATH=docs
