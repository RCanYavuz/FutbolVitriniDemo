# Bu dosyayi .env olarak kopyalayin: cp .env.example .env
# Bos birakilirsa uygulama ayni origin uzerinden /api/v1 yolunu kullanir.
# Backend ayri bir domainde ise tam adres verin (orn: https://api.futbolvitrini.com/api/v1)
VITE_API_URL=

# vite dev sunucusunun /api isteklerini yonlendirecegi backend adresi
VITE_DEV_API_PROXY=http://localhost:3000
